{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "EXECUTAR",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker compose -f ./docker/docker-compose.yaml up"
        },
        {
            "name": "COMPILAR FRONTEND PARA DESENVOLVIMENTO",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker exec -it application_alpine_container bash -c \"go run /workspace/build.go\""
        },
        {
            "name": "TERMINAL ALPINE",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker exec -it application_alpine_container bash"
        },
        {
            "name": "COMPILAR FRONTEND",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker exec -it application_alpine_container sh -c 'cd resources/application && npx rollup -c'"
        },
        {
            "name": "AIDER",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker exec -it application_python_container aider --map-tokens 0 --chat-language portuguese"
        }
    ]
}