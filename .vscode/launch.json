{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "EXECUTAR",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker compose -f ./docker/docker-compose.yaml up"
        },
        {
            "name": "TERMINAL",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker exec -it application_node_container bash"
        },
        {
            "name": "COMPILAR",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker exec -it application_node_container sh -c 'cd resources && npx rollup -c'"
        },
        {
            "name": "AIDER",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker exec -it application_python_container aider --map-tokens 0 --chat-language portuguese"
        }
    ]
}