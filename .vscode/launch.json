{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "EXECUTAR",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker compose -f ./docker/docker-compose.yaml up"
        },
        {
            "name": "EXECUTAR CONTAINERS COM NGROK",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker compose --profile ngrok -f ./docker/docker-compose.yaml up"
        },
        {
            "name": "COMPILAR BACKEND",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker compose -f ./docker/docker-compose.yaml run --rm application_java"
        },
        {
            "name": "CHECAR FRONTEND",
            "request": "launch",
            "type": "node-terminal",
