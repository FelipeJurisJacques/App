env-file: /workspace/.env

# modo de edicao: 'whole', 'diff' ou 'architect'
edit-format: diff

model: openrouter/qwen/qwen3.8-max:free

openai-api-base: "https://api.xkiro.com/v1"

stream: true
map-tokens: 0
dark-mode: true
show-diffs: true
yes-always: true
no-auto-commits: true
chat-language: portuguese
show-model-warnings: true

# auto-commit: true
# test-cmd: "npm test"
# lint-cmd: "npm run lint"
